# ─── Local API mode ─────────────────────────────────────────────────────────
# Keep TRUE while there is no reachable backend.
# false → app calls EXPO_PUBLIC_API_BASE_URL (will fail if that host is down).
EXPO_PUBLIC_USE_MOCKS=true

# Optional real backend (only used when USE_MOCKS=false)
# EXPO_PUBLIC_API_BASE_URL=https://api.bhaiway.dev/v1

# ─── Google Maps / Places (required for Maps-quality location search) ───────
# 1. Enable Places API (New), Places API, Geocoding API + billing
# 2. Paste the same key below
# 3. Restart: npx expo start -c
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
